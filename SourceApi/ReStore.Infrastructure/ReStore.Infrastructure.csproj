<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mapping: Mapster replaces AutoMapper (decision D2). -->
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Mapster.DependencyInjection" Version="1.0.1" />
    <!-- String-based Where/OrderBy so client-supplied filters stay data, not code. -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.1" />
    <!-- Image storage adapter (IImageStorage). -->
    <PackageReference Include="CloudinaryDotNet" Version="1.20.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="Stripe.net" Version="41.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Redis + RabbitMQ are packaged now and registered later (decision D9).
         Both adapters are fail-soft: nothing here connects until the registration
         is uncommented in IoC/ServiceRegistration.cs. -->
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    <PackageReference Include="MassTransit" Version="8.5.7" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.21">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceRegistration reads IConfiguration and registers into IServiceCollection.
         Abstractions only: Configuration.Binder is deliberately NOT referenced, so
         settings are bound by indexer (see ServiceRegistration.ReadRedisSettings). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReStore.Domain\ReStore.Domain.csproj" />
    <ProjectReference Include="..\ReStore.Application\ReStore.Application.csproj" />
  </ItemGroup>

</Project>
