<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- User : IdentityUser<int> and Role : IdentityRole<int> need the Identity store
       abstractions. Deliberately NOT the EF-flavoured Identity package: Domain must
       not know about Entity Framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.21" />
  </ItemGroup>

</Project>
