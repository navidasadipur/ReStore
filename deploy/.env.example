# Copy this to /opt/restore/.env and fill in real values.
#
#   sudo -u runner cp /opt/restore/.env.example /opt/restore/.env   # (first time)
#   sudo -u runner chmod 600 /opt/restore/.env
#
# NEVER commit the filled-in .env. Compose reads this file automatically to
# substitute the ${...} placeholders in compose.yml.

# ---------------------------------------------------------------------------
# Which image the `app` service runs.
#   manual build on the server : RESTORE_IMAGE=restore        RESTORE_TAG=manual
#   image built by CI (GHCR)   : RESTORE_IMAGE=ghcr.io/navidasadipur/restore
# ---------------------------------------------------------------------------
RESTORE_IMAGE=ghcr.io/navidasadipur/restore
RESTORE_TAG=latest

# ---------------------------------------------------------------------------
# Database. Generate a password:  openssl rand -base64 24
# ---------------------------------------------------------------------------
POSTGRES_USER=restoreuser
POSTGRES_DB=restore
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Auth. Signing key for JWTs, 32+ chars.  Generate:  openssl rand -base64 48
# Changing it logs every user out.
# ---------------------------------------------------------------------------
JWT_TOKEN_KEY=

# ---------------------------------------------------------------------------
# Stripe - https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary - https://console.cloudinary.com/settings/api-keys
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
